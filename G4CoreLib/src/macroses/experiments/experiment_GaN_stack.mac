############################################################
# experiment_GaN_stack.mac
############################################################

/exp/reset
/exp/type stack

# World
/exp/world/material G4_Galactic
/exp/world/size 2 cm

# Materials
/exp/material/create GaN 6.15 g/cm3
/exp/material/addMassFraction GaN Ga 0.8326
/exp/material/addMassFraction GaN N  0.1674
/exp/material/finalize GaN

#/exp/material/create Au 19.32 g/cm3
#/exp/material/addMassFraction Au Au 1
#/exp/material/finalize Au

#/exp/material/create Ti 4.5 g/cm3
#/exp/material/addMassFraction Ti Ti 1
#/exp/material/finalize Ti

/exp/material/createx AlGaN_20 0.01
/exp/material/createx InGaN_20 0.004

# Geometry
/exp/stack/xy 10 mm 10 mm
/exp/layers/clear

/exp/layer/add Ni63_Source 50 um
/exp/layer/add G4_Au 20 nm
/exp/layer/add G4_Ti 50 nm
/exp/layer/add GaN 200 nm
/exp/layer/add GaN 750 nm
/exp/layer/add GaN 1 um

# Source
/exp/source/type decay
#/exp/source/type gun
#/exp/source/gun/particle e-
#/exp/source/gun/energy 17.4 keV
#/exp/source/gun/pos 0 0 20 um
#/exp/source/gun/dir 0 0 -1

/exp/apply

/vis/scene/add/axes 0 0 0 5 um auto true

/run/setCut 1 nm
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 ns

# /vis/viewer/refresh
# /vis/drawVolume